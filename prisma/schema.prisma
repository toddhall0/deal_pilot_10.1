// Prisma schema for Deal Pilot
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Authentication Models (NextAuth.js)
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// User & Organization Models
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  accounts         Account[]
  sessions         Session[]
  organizationUsers OrganizationUser[]
  assignedTasks    Task[]            @relation("AssignedTasks")
  createdTasks     Task[]            @relation("CreatedTasks")
  createdDeals     Deal[]            @relation("CreatedDeals")
  notes            Note[]
  comments         Comment[]
  notifications    Notification[]
  activityLogs     ActivityLog[]

  @@map("users")
}

enum UserRole {
  ADMIN
  USER
  VIEWER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users   OrganizationUser[]
  clients Client[]
  deals   Deal[]

  @@map("organizations")
}

model OrganizationUser {
  id             String           @id @default(cuid())
  userId         String           @map("user_id")
  organizationId String           @map("organization_id")
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("organization_users")
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ============================================
// Client Models
// ============================================

model Client {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  email          String?
  phone          String?
  company        String?
  address        String?
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals        Deal[]

  @@map("clients")
}

// ============================================
// Deal Models
// ============================================

model Deal {
  id             String     @id @default(cuid())
  organizationId String     @map("organization_id")
  clientId       String?    @map("client_id")
  createdById    String     @map("created_by_id")
  name           String
  description    String?    @db.Text
  propertyType   PropertyType
  transactionType TransactionType
  status         DealStatus @default(ACTIVE)
  priority       Priority   @default(MEDIUM)

  // Property Details
  propertyAddress String?   @map("property_address")
  propertyCity    String?   @map("property_city")
  propertyState   String?   @map("property_state")
  propertyZip     String?   @map("property_zip")

  // Financial
  purchasePrice   Decimal?  @map("purchase_price") @db.Decimal(15, 2)
  earnestMoney    Decimal?  @map("earnest_money") @db.Decimal(15, 2)

  // Key Dates
  contractDate    DateTime? @map("contract_date")
  dueDiligenceEnd DateTime? @map("due_diligence_end")
  closingDate     DateTime? @map("closing_date")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("CreatedDeals", fields: [createdById], references: [id])
  tasks        Task[]
  documents    Document[]
  notes        Note[]
  milestones   Milestone[]
  activityLogs ActivityLog[]

  @@index([organizationId])
  @@index([status])
  @@map("deals")
}

enum PropertyType {
  OFFICE
  RETAIL
  INDUSTRIAL
  MULTIFAMILY
  HOSPITALITY
  LAND
  MIXED_USE
  OTHER
}

enum TransactionType {
  ACQUISITION
  DISPOSITION
  REFINANCE
  LEASE
}

enum DealStatus {
  DRAFT
  ACTIVE
  UNDER_CONTRACT
  DUE_DILIGENCE
  CLOSING
  CLOSED
  TERMINATED
  ON_HOLD
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ============================================
// Task Models
// ============================================

model Task {
  id          String     @id @default(cuid())
  dealId      String     @map("deal_id")
  parentId    String?    @map("parent_id")
  milestoneId String?    @map("milestone_id")
  assigneeId  String?    @map("assignee_id")
  createdById String     @map("created_by_id")

  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?  @map("due_date")
  completedAt DateTime?  @map("completed_at")
  sortOrder   Int        @default(0) @map("sort_order")

  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relations
  deal      Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  parent    Task?      @relation("SubTasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks  Task[]     @relation("SubTasks")
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee  User?      @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User       @relation("CreatedTasks", fields: [createdById], references: [id])
  comments  Comment[]

  @@index([dealId])
  @@index([status])
  @@index([assigneeId])
  @@map("tasks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  COMPLETED
  CANCELLED
}

model Milestone {
  id          String   @id @default(cuid())
  dealId      String   @map("deal_id")
  name        String
  description String?  @db.Text
  dueDate     DateTime? @map("due_date")
  completedAt DateTime? @map("completed_at")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  deal  Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([dealId])
  @@map("milestones")
}

// ============================================
// Document Models
// ============================================

model Document {
  id          String         @id @default(cuid())
  dealId      String         @map("deal_id")
  name        String
  description String?
  fileUrl     String         @map("file_url")
  fileType    String         @map("file_type")
  fileSize    Int            @map("file_size")
  category    DocumentCategory
  uploadedAt  DateTime       @default(now()) @map("uploaded_at")

  // AI Analysis
  aiSummary   String?        @map("ai_summary") @db.Text
  aiExtractedData Json?      @map("ai_extracted_data")
  analyzedAt  DateTime?      @map("analyzed_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([category])
  @@map("documents")
}

enum DocumentCategory {
  CONTRACT
  AMENDMENT
  TITLE
  SURVEY
  ENVIRONMENTAL
  FINANCIAL
  LEGAL
  CORRESPONDENCE
  OTHER
}

// ============================================
// Notes & Comments
// ============================================

model Note {
  id        String   @id @default(cuid())
  dealId    String   @map("deal_id")
  userId    String   @map("user_id")
  title     String?
  content   String   @db.Text
  isPinned  Boolean  @default(false) @map("is_pinned")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([dealId])
  @@map("notes")
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@map("comments")
}

// ============================================
// Notifications & Activity
// ============================================

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE
  TASK_COMPLETED
  DEAL_UPDATE
  COMMENT_ADDED
  DOCUMENT_UPLOADED
  DEADLINE_APPROACHING
  SYSTEM
}

model ActivityLog {
  id        String   @id @default(cuid())
  dealId    String?  @map("deal_id")
  userId    String   @map("user_id")
  action    String
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  deal Deal? @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id])

  @@index([dealId])
  @@index([userId])
  @@map("activity_logs")
}
